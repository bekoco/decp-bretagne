table Titulaire

	column titulaire_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: titulaire_id

	column type_identifiant
		dataType: string
		summarizeBy: none
		sourceColumn: type_identifiant

	column titulaire_nom
		dataType: string
		summarizeBy: none
		sourceColumn: titulaire_nom

	column taille_entreprise
		dataType: string
		summarizeBy: none
		sourceColumn: taille_entreprise

	column activite_code
		dataType: string
		summarizeBy: none
		sourceColumn: activite_code

	column activite
		dataType: string
		summarizeBy: none
		sourceColumn: activite

	column commune
		dataType: string
		summarizeBy: none
		sourceColumn: commune

	column departement
		dataType: string
		summarizeBy: none
		sourceColumn: departement

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column est_breton
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_breton

	partition Titulaire = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DossierDonnees & "titulaire.parquet"))
				in
				    Source
