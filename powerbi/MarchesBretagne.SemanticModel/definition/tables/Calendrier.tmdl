table Calendrier
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: date

	column annee
		dataType: int64
		summarizeBy: none
		sourceColumn: annee

	column trimestre
		dataType: int64
		summarizeBy: none
		sourceColumn: trimestre

	column mois
		dataType: int64
		summarizeBy: none
		sourceColumn: mois

	column mois_nom
		dataType: string
		sortByColumn: mois
		summarizeBy: none
		sourceColumn: mois_nom

	column annee_mois
		dataType: string
		summarizeBy: none
		sourceColumn: annee_mois

	partition Calendrier = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DossierDonnees & "calendrier.parquet"))
				in
				    Source
