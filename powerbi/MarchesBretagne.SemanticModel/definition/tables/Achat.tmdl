table Achat
	lineageTag: 32219ad4-1559-47c1-8457-5985f4bd9ab8

	/// Nombre d'achats (marchés dédoublonnés, depuis 2019)
	measure Achats = COUNTROWS ( Achat )
		formatString: #,0
		displayFolder: Volume
		lineageTag: b4ebcea3-77f4-499c-a37a-15bb2dc535d9

	/// Somme des montants retenus (ordre de grandeur : souvent des maximums d'accords-cadres)
	measure 'Montant total' = SUM ( Achat[montant] )
		formatString: #,0 €
		displayFolder: Volume
		lineageTag: 76241ac3-c7e2-4e11-bab7-43db946e711e

	/// Montant du marché typique : la médiane, insensible aux montants géants
	measure 'Montant médian' = MEDIAN ( Achat[montant] )
		formatString: #,0 €
		displayFolder: Volume
		lineageTag: 4f707565-fe23-4a3d-8b23-c6856c1da7e3

	/// Part des achats n'ayant reçu qu'une offre, parmi ceux où le nombre d'offres est connu
	measure 'Taux offre unique' =
			DIVIDE (
			    COALESCE ( CALCULATE ( COUNTROWS ( Achat ), Achat[offres_recues] = 1 ), 0 ),
			    COUNT ( Achat[offres_recues] )
			)
		formatString: 0.0 %
		displayFolder: Concurrence
		lineageTag: ec28299d-67e2-4e15-84e7-c81823ad888a

	/// Part des achats où le nombre d'offres est renseigné
	measure 'Couverture offres' = DIVIDE ( COUNT ( Achat[offres_recues] ), [Achats] )
		formatString: 0.0 %
		displayFolder: Concurrence
		lineageTag: 120e872d-9e23-4fe1-a5bf-f0e91c0cfb7a

	measure 'Offres reçues (médiane)' = MEDIAN ( Achat[offres_recues] )
		formatString: 0.0
		displayFolder: Concurrence
		lineageTag: 3859c63f-b3a6-4a77-b96d-f50524ecc9a3

	/// Part des achats avec une clause ou un critère environnemental, parmi ceux où l'information existe
	measure 'Part clause environnementale' =
			DIVIDE (
			    COALESCE ( CALCULATE ( COUNTROWS ( Achat ), Achat[clause_environnementale] = TRUE () ), 0 ),
			    CALCULATE ( COUNTROWS ( Achat ), NOT ISBLANK ( Achat[clause_environnementale] ) )
			)
		formatString: 0.0 %
		displayFolder: Clauses
		lineageTag: e986fcfc-98e9-4af2-9d40-1a5f7f55c72e

	measure 'Part clause sociale' =
			DIVIDE (
			    COALESCE ( CALCULATE ( COUNTROWS ( Achat ), Achat[clause_sociale] = TRUE () ), 0 ),
			    CALCULATE ( COUNTROWS ( Achat ), NOT ISBLANK ( Achat[clause_sociale] ) )
			)
		formatString: 0.0 %
		displayFolder: Clauses
		lineageTag: 221cb76a-5a35-4e3e-a1fc-8bdb1dd34dd7

	measure 'Couverture clauses' = DIVIDE ( CALCULATE ( COUNTROWS ( Achat ), NOT ISBLANK ( Achat[clause_environnementale] ) ), [Achats] )
		formatString: 0.0 %
		displayFolder: Clauses
		lineageTag: fe842554-e0f5-4917-884a-2a87e8f4f7a9

	/// Part des achats modifiés par au moins un avenant
	measure 'Part modifiés' = DIVIDE ( COALESCE ( CALCULATE ( COUNTROWS ( Achat ), Achat[nb_modifications] > 0 ), 0 ), [Achats] )
		formatString: 0.0 %
		displayFolder: Avenants
		lineageTag: 2f6f0b2a-26ba-482e-9c1d-52772ff1284f

	/// Évolution cumulée du montant des achats modifiés (mêmes achats au numérateur et au dénominateur)
	measure 'Évolution montant avenants' =
			VAR Modifies =
			    FILTER ( Achat, Achat[nb_modifications] > 0 && Achat[montant] > 0 && Achat[montant_initial] > 0 )
			RETURN
			    DIVIDE ( SUMX ( Modifies, Achat[montant] ), SUMX ( Modifies, Achat[montant_initial] ) ) - 1
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Avenants
		lineageTag: 01a213cc-5d45-4361-9228-92fcee046d1b

	/// Achats signalés par au moins une règle de détection (étape 5)
	measure 'Achats signalés' = COALESCE ( CALCULATE ( COUNTROWS ( Achat ), Achat[signale_par_nous] = "Oui" ), 0 )
		formatString: #,0
		displayFolder: Anomalies
		lineageTag: 312516cc-9535-47dc-80df-7596ae0e0237

	/// Part des achats signalés, parmi ceux qui ont pu être évalués (montant publié positif)
	measure 'Part signalée' = DIVIDE ( [Achats signalés], CALCULATE ( COUNTROWS ( Achat ), Achat[signale_par_nous] <> "Non évalué" ) )
		formatString: 0.0 %
		displayFolder: Anomalies
		lineageTag: 9a238155-6aa9-4cc5-9be2-4fc8c494b296

	/// Montant tel que publié, pour les seuls achats signalés (vide sinon : la table n'affiche qu'eux)
	measure 'Montant publié (signalé)' = CALCULATE ( SUM ( Achat[montant_brut] ), Achat[signale_par_nous] = "Oui" )
		formatString: #,0.00 €
		displayFolder: Anomalies
		lineageTag: 378bf58a-e2e0-4a80-bfc5-e6fac0fef2a1

